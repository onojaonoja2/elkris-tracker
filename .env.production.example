APP_NAME="Elkris Foods DFAS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dfasdemo.elkrisfoods.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dfa
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

OLD_DB_CONNECTION=mysql
OLD_DB_HOST=your_legacy_db_host
OLD_DB_PORT=3306
OLD_DB_DATABASE=your_legacy_db_name
OLD_DB_USERNAME=your_legacy_db_username
OLD_DB_PASSWORD=your_legacy_db_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@elkrisfoods.com"
MAIL_FROM_NAME="${APP_NAME}"

COPILOT_PROVIDER=deepseek
COPILOT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
